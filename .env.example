RELAY_DOMAIN=audio.your-domain.example
RELAY_PORT=8843
ACME_EMAIL=you@example.com
# Production CLASSIC developer key and secret, joined with a colon. Not an OTE key or PAT.
GODADDY_API_TOKEN=your-production-api-key:your-production-api-secret
SENDER_KEY=replace-with-long-random-sender-key
RECEIVER_KEY=replace-with-different-random-receiver-key

# Separate dashboard password; setup-relay.sh generates one if missing.
ADMIN_PASSWORD=replace-with-separate-random-admin-password
